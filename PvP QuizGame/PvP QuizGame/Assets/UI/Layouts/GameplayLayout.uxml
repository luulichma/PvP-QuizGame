<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles/GlobalStyles.uss" />
    <!-- [PHASE-2] Template Power-Up Bar -->
    <ui:Template name="PowerUpBar" src="project:/Assets/UI/Layouts/PowerUpBar.uxml" />
    <ui:VisualElement name="root" class="bg-gradient" style="flex-grow: 1; padding: 28px;">

        <!-- HUD — Player Info + Timer -->
        <ui:VisualElement name="hud" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 24px; margin-top: 80px;">
            <!-- Player 1 (Me) -->
            <ui:VisualElement name="p1-info" class="player-card" style="width: 320px; overflow: hidden;">
                <ui:VisualElement name="p1-avatar" class="avatar-ring avatar-ring-cyan" style="width: 100px; height: 100px; border-radius: 50px; margin-right: 18px; flex-shrink: 0;" />
                <ui:VisualElement style="flex-shrink: 1; overflow: hidden;">
                    <ui:Label name="p1-label" text="ME" style="color: rgba(255, 255, 255, 0.5); font-size: 26px; letter-spacing: 1px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" />
                    <ui:Label name="p1-score" text="0" style="color: white; font-size: 64px; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Timer Ring — Energy Drain Arc -->
            <ui:VisualElement name="timer-container" style="align-items: center; justify-content: center; width: 160px; height: 160px;">
                <ui:VisualElement name="timer-ring-bg" class="timer-ring" style="position: absolute; width: 100%; height: 100%;" />
                <!-- TimerArcElement được thêm vào runtime trong GameplayUIController_UXML.cs -->
                <ui:Label name="timer-text" text="15" style="color: white; font-size: 54px; -unity-font-style: bold;" />
            </ui:VisualElement>

            <!-- Player 2 (Opponent) -->
            <ui:VisualElement name="p2-info" class="player-card" style="flex-direction: row-reverse; width: 320px; overflow: hidden;">
                <ui:VisualElement name="p2-avatar" class="avatar-ring avatar-ring-gold" style="width: 100px; height: 100px; border-radius: 50px; margin-left: 18px; flex-shrink: 0;" />
                <ui:VisualElement style="align-items: flex-end; flex-shrink: 1; overflow: hidden;">
                    <ui:Label name="p2-label" text="OPP" style="color: rgba(255, 255, 255, 0.5); font-size: 26px; letter-spacing: 1px; -unity-text-align: upper-right; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" />
                    <ui:Label name="p2-score" text="0" style="color: white; font-size: 64px; -unity-font-style: bold; -unity-text-align: upper-right;" />
                </ui:VisualElement>
                <ui:Label name="p2-status" text="Dang suy nghi..." style="color: rgba(255, 255, 255, 0.35); font-size: 20px; -unity-font-style: italic; position: absolute; bottom: 8px; right: 36px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- QUESTION AREA -->
        <ui:VisualElement name="question-area" style="flex-grow: 1; justify-content: center; align-items: center; width: 100%; margin-top: 20px;">
            <!-- Row 1: Question counter — big & prominent -->
            <ui:Label name="question-counter" text="CAU HOI 1" style="color: #B388FF; font-size: 40px; letter-spacing: 3px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 16px;" />
            <!-- Row 2: Progress bar + fraction -->
            <ui:VisualElement style="flex-direction: row; align-items: center; width: 90%; max-width: 800px; margin-bottom: 20px;">
                <ui:VisualElement name="progress-bar-bg" style="flex-grow: 1; height: 10px; background-color: rgba(255, 255, 255, 0.1); border-radius: 5px; overflow: hidden; margin-right: 16px;">
                    <ui:VisualElement name="progress-bar-fill" style="width: 10%; height: 100%; background-color: #00E5FF; border-radius: 5px;" />
                </ui:VisualElement>
                <ui:Label name="question-progress-text" text="1 / 10" style="color: rgba(255,255,255,0.7); font-size: 28px; -unity-font-style: bold; flex-shrink: 0;" />
            </ui:VisualElement>
            <ui:VisualElement class="question-card" style="flex-grow: 1; width: 100%; max-height: 450px;">
                <ui:Label name="question-text" text="Cau hoi dang duoc tai...?" style="color: white; font-size: 42px; -unity-text-align: middle-center; -unity-font-style: bold; white-space: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ANSWERS GRID -->
        <ui:VisualElement name="answers-grid" style="margin-top: 30px; margin-bottom: 12px; flex-direction: column; width: 100%; max-width: 900px; align-self: center;">
            <ui:Button name="ans-0" text="DA 1" class="btn btn-ans-red" style="min-height: 100px; font-size: 32px; margin-bottom: 16px; margin-left: 0; margin-right: 0; border-radius: 20px;" />
            <ui:Button name="ans-1" text="DA 2" class="btn btn-ans-blue" style="min-height: 100px; font-size: 32px; margin-bottom: 16px; margin-left: 0; margin-right: 0; border-radius: 20px;" />
            <ui:Button name="ans-2" text="DA 3" class="btn btn-ans-yellow" style="min-height: 100px; font-size: 32px; margin-bottom: 16px; margin-left: 0; margin-right: 0; border-radius: 20px;" />
            <ui:Button name="ans-3" text="DA 4" class="btn btn-ans-green" style="min-height: 100px; font-size: 32px; margin-left: 0; margin-right: 0; border-radius: 20px;" />
        </ui:VisualElement>

        <!-- [PHASE-2] POWER-UP BAR — Instance từ PowerUpBar.uxml (wire SerializeField VisualTreeAsset trong GameplayUIController_UXML) -->
        <ui:VisualElement name="powerup-bar-container" style="width: 100%; max-width: 900px; align-self: center; margin-top: 4px; margin-bottom: 12px;">
            <ui:Instance template="PowerUpBar" name="powerup-bar-instance" />
        </ui:VisualElement>

        <!-- SETTINGS BUTTON — Glass circle at top right -->
        <ui:Button name="settings-btn" class="icon-btn" style="position: absolute; top: 20px; right: 20px; width: 80px; height: 80px; border-radius: 40px; padding-bottom: 4px; flex-direction: row; justify-content: center; align-items: center;">
            <ui:VisualElement class="icon icon-settings" style="width: 48px; height: 48px;" />
        </ui:Button>

        <!-- PARTICLE CONTAINER — For confetti / sparkle effects -->
        <ui:VisualElement name="particle-layer" class="particle-container" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
