<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles/GlobalStyles.uss" />
    <!-- [PHASE-2] Template Shop Panel -->
    <ui:Template name="ShopPanel" src="project:/Assets/UI/Layouts/ShopPanel.uxml" />

    <!-- Root Container: Flex Column -->
    <ui:VisualElement name="root" class="bg-gradient" style="flex-grow: 1; display: flex; flex-direction: column; overflow: hidden;">

        <!-- Animated Background Orbs -->
        <ui:VisualElement name="bg-orbs-container" picking-mode="Ignore" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; overflow: hidden;">
            <ui:VisualElement name="glow-orb-1" style="position: absolute; width: 1200px; height: 1200px; border-radius: 600px; background-color: rgba(0, 229, 255, 0.03); top: -20%; left: -20%;" />
            <ui:VisualElement name="glow-orb-2" style="position: absolute; width: 1000px; height: 1000px; border-radius: 500px; background-color: rgba(179, 136, 255, 0.04); bottom: -20%; right: -10%;" />
            <ui:VisualElement name="glow-orb-3" style="position: absolute; width: 800px; height: 800px; border-radius: 400px; background-color: rgba(255, 209, 102, 0.02); top: 30%; left: 40%;" />
        </ui:VisualElement>

        <!-- Background Particles -->
        <ui:VisualElement name="home-particle-layer" class="particle-container" picking-mode="Ignore" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0;" />

        <!-- CONTENT AREA -->
        <ui:VisualElement name="content-area" style="flex-grow: 1; flex-shrink: 1; padding: 36px; padding-bottom: 12px; min-height: 0;">

            <!-- HOME PANEL -->
            <ui:VisualElement name="home-panel" style="flex-grow: 1; flex-shrink: 1; min-height: 0;">
                <!-- Header Profile — Glassmorphism Card (Responsive: column layout to avoid horizontal overflow) -->
                <ui:VisualElement name="header" style="flex-direction: column; margin-bottom: 30px; flex-shrink: 0;">
                    <!-- Top row: Profile button (grow) + Settings button (fixed) -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: flex-start; width: 100%;">
                        <ui:Button name="open-profile-btn" style="flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: row; align-items: center; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 22px; padding: 12px 18px; margin: 0; margin-right: 16px;">
                            <ui:VisualElement name="avatar" class="avatar-ring" style="width: 100px; height: 100px; border-radius: 50px; margin-right: 16px; flex-shrink: 0;" />
                            <ui:VisualElement name="labels" style="align-items: flex-start; flex-grow: 1; flex-shrink: 1; min-width: 0;">
                                <ui:Label name="name-label" text="PLAYER NAME" style="color: white; font-size: 40px; -unity-font-style: bold; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;" />
                                <ui:Label name="level-tag" text="LEVEL 5" class="header-tag" style="font-size: 30px; padding: 4px 10px; margin-bottom: 6px;" />
                                <!-- XP Bar -->
                                <ui:VisualElement class="xp-bar-container" style="width: 100%; max-width: 280px; height: 14px;">
                                    <ui:VisualElement name="xp-fill" class="xp-bar-fill" style="width: 0%; height: 100%;" />
                                </ui:VisualElement>
                                <ui:Label name="xp-label" text="0 / 500" style="color: rgba(255,255,255,0.35); font-size: 22px; margin-top: 4px;" />

                                <!-- [UI Refactor] Tier badge nổi bật — thay thế season-info cũ -->
                                <ui:VisualElement name="tier-badge-card" class="tier-badge-large tier-bronze" style="margin-top: 8px; flex-shrink: 0;">
                                    <ui:VisualElement name="tier-badge-icon" class="icon icon-award icon-tint-bronze icon-md" style="margin-right: 10px;" />
                                    <ui:VisualElement style="flex-direction: column; align-items: flex-start;">
                                        <ui:Label name="tier-badge-name" text="DONG" class="tier-badge-large-name" />
                                        <ui:Label name="tier-badge-rp" text="0 RP" class="tier-badge-large-rp" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="settings-btn" class="icon-btn" style="flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center;">
                            <ui:VisualElement class="icon icon-settings icon-md" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Money block on its own row to avoid horizontal overlap -->
                    <ui:VisualElement name="money-block" style="flex-direction: row; align-self: flex-start; align-items: center; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 22px; padding: 10px 22px; margin-top: 12px;">
                        <ui:VisualElement class="icon icon-coins icon-tint-money icon-md" style="margin-right: 12px;" />
                        <ui:Label name="money-label" text="$1,250" style="color: #FFD166; -unity-font-style: bold; font-size: 44px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Hero Banner — Glassmorphism glow (KHÔNG còn intermission overlay) -->
                <ui:VisualElement name="hero" style="align-items: center; margin-bottom: 30px; padding: 16px; flex-shrink: 0;">
                    <ui:Label name="hero-title-label" text="PVP QUIZ GAME" class="hero-title" style="white-space: normal; -unity-text-align: middle-center;" />
                    <ui:Label name="hero-subtitle-label" text="THU THACH KIEN THUC" class="hero-subtitle" style="white-space: normal; -unity-text-align: middle-center;" />
                </ui:VisualElement>

                <!-- Main Content (Center) -->
                <ui:VisualElement name="content" style="flex-grow: 1; flex-shrink: 1; min-height: 0; justify-content: center; align-items: center;">
                    <ui:Button name="find-match-btn" text="TIM TRAN DAU" class="btn btn-glow" style="width: 85%; height: 150px; font-size: 56px; margin: 0; margin-bottom: 20px; border-radius: 26px; letter-spacing: 2px; flex-shrink: 0;" />
                    <ui:Button name="practice-btn" text="DAU VOI MAY" class="btn btn-secondary" style="width: 78%; height: 120px; font-size: 44px; margin: 0; margin-bottom: 20px; border-radius: 22px; flex-shrink: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- [PHASE-2] SHOP PANEL — Instance ShopPanel.uxml (Ẩn mặc định) -->
            <ui:VisualElement name="shop-panel" class="main-panel" style="display: none;">
                <ui:Instance template="ShopPanel" name="shop-panel-instance" />
            </ui:VisualElement>

            <!-- [UI Refactor] RANK PANEL — Season banner + tier filter + BXH -->
            <ui:VisualElement name="rank-panel" style="flex-grow: 1; display: none; padding-bottom: 20px;">
                <!-- Season banner — chuyển từ home/header sang đây -->
                <ui:VisualElement name="rank-season-banner" class="rank-season-banner">
                    <ui:VisualElement style="flex-direction: column; align-items: center;">
                        <ui:Label name="rank-season-title" text="MUA 1" class="rank-season-title" />
                        <ui:Label name="rank-season-info" text="Con 30 ngay" class="rank-season-info" />
                        <ui:Label name="rank-season-message" text="" class="rank-season-message" style="display: none;" />
                        <ui:Label name="rank-season-countdown" text="" class="rank-season-countdown" style="display: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tier filter chips -->
                <ui:VisualElement name="tier-filter-tabs" class="tier-filter-tabs">
                    <ui:Button name="tier-tab-1" class="tier-tab tier-tab-bronze" style="flex-direction: row; justify-content: center; align-items: center;">
                        <ui:VisualElement class="icon icon-award icon-tint-bronze icon-sm" style="margin-right: 6px;" />
                        <ui:Label text="DONG" style="-unity-font-style: bold;" />
                    </ui:Button>
                    <ui:Button name="tier-tab-2" class="tier-tab tier-tab-silver" style="flex-direction: row; justify-content: center; align-items: center;">
                        <ui:VisualElement class="icon icon-award icon-tint-silver icon-sm" style="margin-right: 6px;" />
                        <ui:Label text="BAC" style="-unity-font-style: bold;" />
                    </ui:Button>
                    <ui:Button name="tier-tab-3" class="tier-tab tier-tab-gold" style="flex-direction: row; justify-content: center; align-items: center;">
                        <ui:VisualElement class="icon icon-award icon-tint-gold icon-sm" style="margin-right: 6px;" />
                        <ui:Label text="VANG" style="-unity-font-style: bold;" />
                    </ui:Button>
                    <ui:Button name="tier-tab-4" class="tier-tab tier-tab-diamond" style="flex-direction: row; justify-content: center; align-items: center;">
                        <ui:VisualElement class="icon icon-gem icon-tint-diamond icon-sm" style="margin-right: 6px;" />
                        <ui:Label text="KIM CUONG" style="-unity-font-style: bold;" />
                    </ui:Button>
                    <ui:Button name="tier-tab-5" class="tier-tab tier-tab-legend" style="flex-direction: row; justify-content: center; align-items: center;">
                        <ui:VisualElement class="icon icon-crown icon-tint-legend icon-sm" style="margin-right: 6px;" />
                        <ui:Label text="HUYEN THOAI" style="-unity-font-style: bold;" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Leaderboard scroll -->
                <ui:VisualElement name="subpanel-leaderboard" class="card-glow" style="flex-grow: 1; padding: 20px; border-radius: 28px;">
                    <ui:Label name="leaderboard-loading-label" text="Dang tai du lieu..." style="font-size: 40px; color: white; -unity-text-align: middle-center; flex-grow: 1; -unity-text-align: middle-center;" />
                    <ui:ScrollView name="leaderboard-scroll" style="flex-grow: 1; display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- [UI Refactor] ACHIEVEMENTS PANEL — gộp Thành tựu + Daily Quests -->
            <ui:VisualElement name="achievements-panel" style="flex-grow: 1; display: none; padding-bottom: 20px;">
                <!-- Sub-tabs trong Achievements panel -->
                <ui:VisualElement class="sub-tabs-container">
                    <ui:Button name="subtab-achievements-btn" class="sub-tab-btn sub-tab-active" text="THANH TUU" />
                    <ui:Button name="subtab-quests-btn" class="sub-tab-btn" text="NHIEM VU" />
                </ui:VisualElement>

                <ui:VisualElement name="subpanel-achievements" class="card-glow" style="flex-grow: 1; padding: 20px; border-radius: 28px;">
                    <ui:ScrollView name="achievements-scroll" style="flex-grow: 1;" />
                </ui:VisualElement>

                <ui:VisualElement name="subpanel-quests" class="card-glow" style="flex-grow: 1; padding: 20px; border-radius: 28px; display: none;">
                    <ui:Label name="quests-title" text="NHIEM VU HANG NGAY" style="font-size: 44px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 8px;" />
                    <ui:Label name="quests-reset-label" text="Reset sau: 23:59" style="font-size: 28px; color: rgba(255,255,255,0.5); -unity-text-align: middle-center; margin-bottom: 14px;" />
                    <ui:ScrollView name="quests-scroll" style="flex-grow: 1;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- MATCHMAKING PANEL (Hidden by default) — Spinner -->
            <ui:VisualElement name="matchmaking-panel" style="flex-grow: 1; justify-content: center; align-items: center; display: none;">
                <ui:VisualElement style="align-items: center; background-color: rgba(255, 255, 255, 0.05); border-radius: 28px; padding: 40px 32px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); width: 90%; max-width: 700px;">
                    <ui:VisualElement class="spinner" />
                    <ui:Label name="searching-label" text="DANG TIM DOI THU..." style="font-size: 48px; color: white; margin-bottom: 8px; letter-spacing: 2px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center;" />
                    <ui:Label text="Vui long cho trong giay lat" style="font-size: 28px; color: rgba(255,255,255,0.3); margin-bottom: 40px; white-space: normal; -unity-text-align: middle-center;" />
                    <ui:Button name="cancel-match-btn" text="HUY TIM KIEM" class="btn btn-danger" style="width: 90%; max-width: 360px; height: 100px; font-size: 40px; border-radius: 22px; margin: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- [UI Refactor] BOTTOM NAVIGATION BAR — 4 tab -->
        <ui:VisualElement class="bottom-nav">
            <ui:Button name="nav-shop-btn" class="nav-tab">
                <ui:VisualElement class="icon icon-shop nav-tab-icon" style="width: 66px; height: 66px;" />
                <ui:Label text="SHOP" class="nav-tab-label" />
            </ui:Button>

            <ui:Button name="nav-home-btn" class="nav-tab nav-tab-active">
                <ui:VisualElement class="icon icon-home nav-tab-icon" style="width: 66px; height: 66px;" />
                <ui:Label text="HOME" class="nav-tab-label" />
            </ui:Button>

            <ui:Button name="nav-rank-btn" class="nav-tab">
                <ui:VisualElement class="icon icon-trophy nav-tab-icon" style="width: 66px; height: 66px;" />
                <ui:Label text="RANK" class="nav-tab-label" />
            </ui:Button>

            <ui:Button name="nav-achievements-btn" class="nav-tab">
                <ui:VisualElement class="icon icon-star nav-tab-icon" style="width: 66px; height: 66px;" />
                <ui:Label text="THANH TUU" class="nav-tab-label" />
            </ui:Button>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
