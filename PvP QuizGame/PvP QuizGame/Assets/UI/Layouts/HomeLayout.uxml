<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles/GlobalStyles.uss" />
    <ui:VisualElement name="root" class="bg-gradient" style="flex-grow: 1; padding: 40px;">
        
        <!-- HOME PANEL -->
        <ui:VisualElement name="home-panel" style="flex-grow: 1;">
            <!-- Header Profile -->
            <ui:VisualElement name="header" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 80px;">
                <ui:Button name="open-profile-btn" style="flex-direction: row; align-items: center; background-color: transparent; border-width: 0; padding: 0; margin: 0;">
                    <ui:VisualElement name="avatar" style="width: 120px; height: 120px; background-color: #00e5ff; border-radius: 60px; border-width: 5px; border-color: white; margin-right: 25px;" />
                    <ui:VisualElement name="labels" style="align-items: flex-start;">
                        <ui:Label name="name-label" text="PLAYER NAME" style="color: white; font-size: 32px; -unity-font-style: bold; margin-bottom: 5px;" />
                        <ui:Label name="money-label" text="$1,250" style="color: #ffea00; -unity-font-style: bold; font-size: 40px; margin-bottom: 5px;" />
                        <ui:Label name="level-tag" text="LEVEL 5" class="header-tag" style="font-size: 20px;" />
                    </ui:VisualElement>
                </ui:Button>
                
                <ui:Button name="settings-btn" class="btn" style="width: 110px; height: 110px; padding: 0; background-color: rgba(0, 0, 0, 0.4); border-radius: 35px; border-width: 4px; border-color: rgba(255, 255, 255, 0.6); justify-content: center; align-items: center;">
                    <ui:VisualElement name="settings-icon" style="flex-grow: 1; width: 100%; height: 100%; background-color: transparent;" />
                </ui:Button>
            </ui:VisualElement>
 
            <!-- Main Content (Center) -->
            <ui:VisualElement name="content" style="flex-grow: 1; justify-content: center; align-items: center;">
                <ui:Label text="PVP QUIZ GAME" style="font-size: 80px; color: white; -unity-font-style: bold; margin-bottom: 150px; -unity-text-outline-width: 4px; -unity-text-outline-color: rgba(0,0,0,0.5);" />
                
                <ui:Button name="find-match-btn" text="TIM TRAN DAU" class="btn btn-primary" style="width: 100%; max-width: 85%; height: 130px; font-size: 48px; margin-bottom: 30px;" />
                <ui:Button name="practice-btn" text="DAU VOI MAY" class="btn btn-secondary" style="width: 100%; max-width: 85%; height: 110px; font-size: 40px; margin-bottom: 30px;" />
                
                <ui:Button name="leaderboard-btn" text="BANG XEP HÀNG" class="btn" style="width: 100%; max-width: 85%; height: 90px; font-size: 32px; background-color: rgba(255,255,255,0.3); border-width: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
 
        <!-- MATCHMAKING PANEL (Hidden by default) -->
        <ui:VisualElement name="matchmaking-panel" style="flex-grow: 1; justify-content: center; align-items: center; display: none;">
            <ui:Label name="searching-label" text="DANG TIM DOI THU..." style="font-size: 48px; color: white; margin-bottom: 50px;" />
            <ui:VisualElement class="progress-container" style="width: 80%; height: 30px;">
                <ui:VisualElement class="progress-fill" style="width: 30%;" />
            </ui:VisualElement>
            <ui:Button name="cancel-match-btn" text="HUY TIM KIEM" class="btn btn-danger" style="margin-top: 100px; width: 400px;" />
        </ui:VisualElement>

        <!-- Footer -->
        <ui:Label name="version-label" text="Version 1.0.0 (Unity 6)" style="font-size: 24px; color: rgba(255,255,255,0.5); align-self: center;" />
    </ui:VisualElement>
</ui:UXML>
