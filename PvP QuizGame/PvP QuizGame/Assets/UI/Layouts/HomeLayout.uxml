<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles/GlobalStyles.uss" />
    <ui:VisualElement name="root" class="bg-gradient" style="flex-grow: 1; padding: 40px;">
        
        <!-- HOME PANEL -->
        <ui:VisualElement name="home-panel" style="flex-grow: 1;">
            <!-- Header Profile -->
            <ui:VisualElement name="header" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 50px;">
                <ui:Button name="open-profile-btn" style="flex-direction: row; align-items: center; background-color: transparent; border-width: 0; padding: 0; margin: 0;">
                    <ui:VisualElement name="avatar" style="width: 110px; height: 110px; border-radius: 55px; border-width: 4px; border-color: rgba(255, 255, 255, 0.6); margin-right: 25px; justify-content: center; align-items: center; overflow: hidden;" />
                    <ui:VisualElement name="labels" style="align-items: flex-start;">
                        <ui:Label name="name-label" text="PLAYER NAME" style="color: white; font-size: 32px; -unity-font-style: bold; margin-bottom: 4px;" />
                        <ui:Label name="money-label" text="$1,250" style="color: #ffea00; -unity-font-style: bold; font-size: 34px; margin-bottom: 2px;" />
                        <ui:Label name="level-tag" text="LEVEL 5" class="header-tag" style="font-size: 18px;" />
                        <!-- G-12: XP Bar -->
                        <ui:VisualElement class="xp-bar-container" style="width: 220px;">
                            <ui:VisualElement name="xp-fill" class="xp-bar-fill" style="width: 0%;" />
                        </ui:VisualElement>
                        <ui:Label name="xp-label" text="0 / 500" style="color: rgba(255,255,255,0.5); font-size: 16px; margin-top: 2px;" />
                    </ui:VisualElement>
                </ui:Button>
                
                <ui:Button name="settings-btn" class="btn" style="width: 100px; height: 100px; padding: 0; background-color: rgba(0, 0, 0, 0.3); border-radius: 30px; border-width: 2px; border-color: rgba(255, 255, 255, 0.3); justify-content: center; align-items: center; font-size: 50px;" text="&#9881;" />
            </ui:VisualElement>

            <!-- G-10: Hero Banner -->
            <ui:VisualElement name="hero" style="align-items: center; margin-bottom: 60px; padding: 30px;">
                <ui:Label text="PVP QUIZ GAME" style="font-size: 72px; color: white; -unity-font-style: bold; -unity-text-outline-width: 3px; -unity-text-outline-color: rgba(0,0,0,0.4);" />
                <ui:Label text="THỬ THÁCH KIẾN THỨC" style="font-size: 28px; color: rgba(255,255,255,0.5); letter-spacing: 4px; margin-top: 10px;" />
            </ui:VisualElement>
 
            <!-- Main Content (Center) -->
            <ui:VisualElement name="content" style="flex-grow: 1; justify-content: center; align-items: center;">
                <ui:Button name="find-match-btn" text="TÌM TRẬN ĐẤU" class="btn btn-primary" style="width: 100%; max-width: 85%; height: 120px; font-size: 44px; margin-bottom: 25px; border-radius: 28px;" />
                <ui:Button name="practice-btn" text="ĐẤU VỚI MÁY" class="btn btn-secondary" style="width: 100%; max-width: 80%; height: 100px; font-size: 36px; margin-bottom: 25px; border-radius: 24px;" />

                <ui:Button name="leaderboard-btn" text="BẢNG XẾP HẠNG" class="btn" style="width: 100%; max-width: 70%; height: 80px; font-size: 28px; background-color: rgba(255,255,255,0.08); border-width: 0; border-radius: 20px; display: none;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- MATCHMAKING PANEL (Hidden by default) — G-14: Spinner -->
        <ui:VisualElement name="matchmaking-panel" style="flex-grow: 1; justify-content: center; align-items: center; display: none;">
            <ui:VisualElement class="spinner" />
            <ui:Label name="searching-label" text="ĐANG TÌM ĐỐI THỦ..." style="font-size: 40px; color: white; margin-bottom: 10px; letter-spacing: 3px;" />
            <ui:Label text="Vui lòng chờ trong giây lát" style="font-size: 24px; color: rgba(255,255,255,0.4); margin-bottom: 80px;" />
            <ui:Button name="cancel-match-btn" text="HỦY TÌM KIẾM" class="btn btn-danger" style="margin-top: 60px; width: 350px; height: 80px; font-size: 32px; border-radius: 24px;" />
        </ui:VisualElement>

        <!-- Footer -->
        <ui:Label name="version-label" text="Version 1.0.0 (Unity 6)" style="font-size: 22px; color: rgba(255,255,255,0.35); align-self: center;" />
    </ui:VisualElement>
</ui:UXML>
