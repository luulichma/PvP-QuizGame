<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles/GlobalStyles.uss" />
    <ui:VisualElement name="root" class="bg-gradient" style="flex-grow: 1; padding: 25px;">
        
        <!-- HOME PANEL -->
        <ui:VisualElement name="home-panel" style="flex-grow: 1;">
            <!-- Header Profile -->
            <ui:VisualElement name="header" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 50px;">
                <ui:VisualElement name="user-info" style="flex-direction: row; align-items: center;">
                    <ui:VisualElement name="avatar" style="width: 60px; height: 60px; background-color: #00e5ff; border-radius: 30px; border-width: 3px; border-color: white; margin-right: 15px;" />
                    <ui:VisualElement name="labels">
                        <ui:Label name="money-label" text="$1,250" style="color: #ffea00; -unity-font-style: bold; font-size: 20px;" />
                        <ui:Label name="level-tag" text="LEVEL 5" class="header-tag" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:Button name="settings-btn" class="btn" style="width: 50px; height: 50px; padding: 0; background-color: rgba(255,255,255,0.2);">
                    <ui:Label text="⚙" style="font-size: 24px; color: white;" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Main Content (Center) -->
            <ui:VisualElement name="content" style="flex-grow: 1; justify-content: center; align-items: center;">
                <ui:Label text="PVP QUIZ GAME" style="font-size: 40px; color: white; -unity-font-style: bold; margin-bottom: 100px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0,0,0,0.5);" />
                
                <ui:Button name="find-match-btn" text="TIM TRAN DAU" class="btn" style="width: 100%; max-width: 300px; height: 80px; font-size: 24px; background-color: #00e676;" />
                
                <ui:Button name="leaderboard-btn" text="BANG XEP HANG" class="btn" style="width: 100%; max-width: 300px; background-color: #00e5ff; margin-top: 15px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- MATCHMAKING PANEL (Hidden by default) -->
        <ui:VisualElement name="matchmaking-panel" style="flex-grow: 1; justify-content: center; align-items: center; display: none;">
            <ui:Label text="DANG TIM DOI THU..." style="font-size: 24px; color: white; margin-bottom: 30px;" />
            <ui:VisualElement class="progress-container" style="width: 80%; height: 20px;">
                <ui:VisualElement class="progress-fill" style="width: 30%;" />
            </ui:VisualElement>
            <ui:Button name="cancel-match-btn" text="HUY TIM KIEM" class="btn" style="margin-top: 50px; background-color: #ff5252;" />
        </ui:VisualElement>

        <!-- Footer -->
        <ui:Label text="Version 1.0.0 (Unity 6)" style="font-size: 12px; color: rgba(255,255,255,0.5); align-self: center;" />
    </ui:VisualElement>
</ui:UXML>
