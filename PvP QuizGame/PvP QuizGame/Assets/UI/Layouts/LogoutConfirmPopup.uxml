<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project:/Assets/UI/Styles/GlobalStyles.uss" />
    <ui:VisualElement name="overlay" class="overlay">
        <ui:VisualElement name="popup-container" class="card" style="width: 80%; max-width: 400px; align-items: center; background-color: rgba(15, 10, 30, 0.85); border-width: 2px; border-color: rgba(255, 255, 255, 0.15); border-radius: 32px; padding: 40px;">
            <ui:Label name="logout-title" text="XÁC NHẬN ĐĂNG XUẤT" style="font-size: 34px; color: white; -unity-font-style: bold; margin-bottom: 15px; letter-spacing: 1px;" />
            <ui:Label name="message-label" text="Bạn có muốn đăng xuất khỏi tài khoản hiện tại?" style="font-size: 22px; color: rgba(255,255,255,0.7); -unity-text-align: middle-center; margin-bottom: 30px; white-space: normal;" />
            <ui:Button name="logout-yes-btn" text="ĐĂNG XUẤT" class="btn btn-danger" style="width: 100%; font-size: 28px; height: 65px; border-radius: 18px; margin-bottom: 10px;" />
            <ui:Button name="logout-no-btn" text="HỦY" class="btn btn-cancel" style="width: 100%; font-size: 22px; height: 55px; border-radius: 16px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
