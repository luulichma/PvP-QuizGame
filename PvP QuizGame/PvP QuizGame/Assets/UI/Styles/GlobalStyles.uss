:root {
}

/* Background Utility */
.bg-gradient {
    background-color: #2D1445; /* Deep Premium Purple */
}

/* Base Card Style (Glassmorphism) */
.card {
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 32px;
    padding: 40px;
    margin-bottom: 20px;
    border-bottom-width: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
}

/* Button Base Styles */
.btn {
    padding: 20px 40px;
    border-radius: 20px;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 42px;
    -unity-text-align: middle-center;
    transition-property: scale, translate, background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
    margin: 10px;
    cursor: initial;
    white-space: normal;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 8px;
}

.btn:hover {
    scale: 1.05;
}

.btn:active {
    scale: 0.95;
    translate: 0 6px;
    border-bottom-width: 2px;
}

/* Button Variants */
.btn-primary {
    background-color: #31B811; /* Lighter Green */
    border-bottom-color: #1D7A08;
}
.btn-primary:hover { background-color: #38D413; }

.btn-secondary {
    background-color: #197BF0; /* Bright Blue */
    border-bottom-color: #0E52A3;
}
.btn-secondary:hover { background-color: #2E8AFF; }

.btn-danger {
    background-color: #F72548; /* Bright Red */
    border-bottom-color: #B0152F;
}
.btn-danger:hover { background-color: #FF3B5C; }

/* Answer Buttons (Pastel Vibrant) */
.btn-ans-red {
    background-color: #E21B3C;
    border-bottom-color: #A30D25;
}
.btn-ans-red:hover { background-color: #FA2A4E; }

.btn-ans-blue {
    background-color: #1368CE;
    border-bottom-color: #0A458F;
}
.btn-ans-blue:hover { background-color: #207BE8; }

.btn-ans-yellow {
    background-color: #D89E00;
    border-bottom-color: #9C7200;
}
.btn-ans-yellow:hover { background-color: #F0B100; }

.btn-ans-green {
    background-color: #26890C;
    border-bottom-color: #165E04;
}
.btn-ans-green:hover { background-color: #31AD11; }

/* Header Info */
.header-tag {
    background-color: #FFD166;
    color: #461A42;
    padding: 6px 16px;
    border-radius: 16px;
    font-size: 30px;
    -unity-font-style: bold;
}

/* Progress Bar */
.progress-container {
    background-color: rgba(0, 0, 0, 0.4);
    height: 20px;
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill {
    background-color: #FFD166;
    height: 100%;
    border-radius: 10px;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* Popup Overlay */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
}
