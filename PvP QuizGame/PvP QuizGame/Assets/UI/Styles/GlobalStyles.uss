:root {
}

/* Background Utility */
.bg-gradient {
    background-color: #4a148c;
}

/* Base Card Style */
.card {
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 30px;
    padding: 40px;
    margin-bottom: 20px;
    border-width: 4px;
    border-color: #ddd;
}

/* Button Styles */
.btn {
    padding: 25px 50px;
    border-radius: 25px;
    border-width: 4px;
    border-color: #ffffff;
    background-color: #00e5ff;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 36px;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
    margin: 10px;
    cursor: initial;
    white-space: normal;
}

.btn:hover {
    scale: 1.05;
    background-color: #ffea00;
    color: #212121;
}

.btn:active {
    scale: 0.95;
    opacity: 0.8;
}

/* Header Info */
.header-tag {
    background-color: #ffea00;
    color: #4a148c;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
}

/* Progress Bar */
.progress-container {
    background-color: rgba(0, 0, 0, 0.2);
    height: 15px;
    border-radius: 10px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

.progress-fill {
    background-color: #00e676;
    height: 100%;
}

/* Popup Overlay */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}
