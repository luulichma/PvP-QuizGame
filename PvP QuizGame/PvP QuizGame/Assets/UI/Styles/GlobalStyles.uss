:root {
    /* Color Palette */
    --color-primary-bg: #4a148c;
    --color-accent-blue: #00e5ff;
    --color-accent-yellow: #ffea00;
    --color-accent-green: #00e676;
    --color-accent-red: #ff5252;
    --color-white: #ffffff;
    --color-dark: #212121;
    --color-overlay: rgba(0, 0, 0, 0.7);

    /* Fonts & Text */
    -unity-font-definition: initial; /* Default font, user can assign Fredoka in Editor */
    --font-size-sm: 14px;
    --font-size-md: 18px;
    --font-size-lg: 24px;
    --font-size-xl: 32px;
}

/* Background Utility */
.bg-gradient {
    background-color: var(--color-primary-bg);
}

/* Base Card Style */
.card {
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: #ddd;
}

/* Button Styles */
.btn {
    padding: 15px 30px;
    border-radius: 15px;
    border-width: 3px;
    border-color: var(--color-white);
    background-color: var(--color-accent-blue);
    color: var(--color-white);
    -unity-font-style: bold;
    font-size: var(--font-size-md);
    transition-duration: 0.1s;
    margin: 5px;
    cursor: initial;
}

.btn:hover {
    scale: 1.05;
    background-color: var(--color-accent-yellow);
    color: var(--color-dark);
}

.btn:active {
    scale: 0.95;
    opacity: 0.8;
}

/* Header Info */
.header-tag {
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-bg);
    padding: 2px 10px;
    border-radius: 10px;
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

/* Progress Bar */
.progress-container {
    background-color: rgba(0, 0, 0, 0.2);
    height: 15px;
    border-radius: 10px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

.progress-fill {
    background-color: var(--color-accent-green);
    height: 100%;
}

/* Popup Overlay */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--color-overlay);
    align-items: center;
    justify-content: center;
}
