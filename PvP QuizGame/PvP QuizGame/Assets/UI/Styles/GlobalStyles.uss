:root {
}

/* Background Utility */
.bg-gradient {
    background-color: #461A42; /* Quizizz Dark Purple */
}

/* Base Card Style */
.card {
    background-color: white;
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 20px;
    border-bottom-width: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-color: rgba(0, 0, 0, 0.15);
}

/* Button Base Styles */
.btn {
    padding: 20px 40px;
    border-radius: 16px;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 42px;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
    margin: 10px;
    cursor: initial;
    white-space: normal;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 8px;
}

.btn:hover {
    scale: 1.03;
}

.btn:active {
    scale: 0.98;
    translate: 0 4px;
    border-bottom-width: 4px;
}

/* Button Variants */
.btn-primary {
    background-color: #26890C;
    border-bottom-color: #1D6B09;
}

.btn-secondary {
    background-color: #1368CE;
    border-bottom-color: #0E52A3;
}

.btn-danger {
    background-color: #E21B3C;
    border-bottom-color: #B0152F;
}

/* Answer Buttons */
.btn-ans-red {
    background-color: #E21B3C;
    border-bottom-color: #B0152F;
}

.btn-ans-blue {
    background-color: #1368CE;
    border-bottom-color: #0E52A3;
}

.btn-ans-yellow {
    background-color: #D89E00;
    border-bottom-color: #A87B00;
}

.btn-ans-green {
    background-color: #26890C;
    border-bottom-color: #1D6B09;
}

/* Header Info */
.header-tag {
    background-color: #FFD166;
    color: #461A42;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 30px;
    -unity-font-style: bold;
}

/* Progress Bar */
.progress-container {
    background-color: rgba(0, 0, 0, 0.3);
    height: 18px;
    border-radius: 9px;
    overflow: hidden;
}

.progress-fill {
    background-color: #FFD166;
    height: 100%;
    border-radius: 9px;
}

/* Popup Overlay */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}
