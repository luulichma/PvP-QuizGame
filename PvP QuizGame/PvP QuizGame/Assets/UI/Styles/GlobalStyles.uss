/* ==========================================================
   GlobalStyles.uss — PvP QuizGame
   Cập nhật: 25/05/2026
   CHỈ sử dụng CSS properties được Unity UI Toolkit hỗ trợ.
   ========================================================== */

/* G-01: Background — Unity USS không hỗ trợ linear-gradient() */
.bg-gradient {
    background-color: #1a0a2e;
}

/* Base Card Style — G-02: Glassmorphism + G-03: Shadow */
.card {
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 32px;
    padding: 40px;
    margin-bottom: 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.20);
}

/* Button Base Styles — G-03: Shadow */
.btn {
    padding: 20px 40px;
    border-radius: 20px;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 42px;
    -unity-text-align: middle-center;
    margin: 10px;
    cursor: initial;
    white-space: normal;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 8px;
}

.btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.btn:active {
    translate: 0 6px;
    border-bottom-width: 2px;
}

/* Button Variants */
.btn-primary {
    background-color: #31B811;
    border-bottom-color: #1D7A08;
}
.btn-primary:hover { background-color: #38D413; }

.btn-secondary {
    background-color: #197BF0;
    border-bottom-color: #0E52A3;
}
.btn-secondary:hover { background-color: #2E8AFF; }

.btn-danger {
    background-color: #F72548;
    border-bottom-color: #B0152F;
}
.btn-danger:hover { background-color: #FF3B5C; }

.btn-cancel {
    background-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
}
.btn-cancel:hover { background-color: rgba(255, 255, 255, 0.15); }

/* Answer Buttons (Pastel Vibrant) */
.btn-ans-red {
    background-color: #E21B3C;
    border-bottom-color: #A30D25;
}
.btn-ans-red:hover { background-color: #FA2A4E; }

.btn-ans-blue {
    background-color: #1368CE;
    border-bottom-color: #0A458F;
}
.btn-ans-blue:hover { background-color: #207BE8; }

.btn-ans-yellow {
    background-color: #D89E00;
    border-bottom-color: #9C7200;
}
.btn-ans-yellow:hover { background-color: #F0B100; }

.btn-ans-green {
    background-color: #26890C;
    border-bottom-color: #165E04;
}
.btn-ans-green:hover { background-color: #31AD11; }

/* Header Info */
.header-tag {
    background-color: #FFD166;
    color: #461A42;
    padding: 6px 16px;
    border-radius: 16px;
    font-size: 30px;
    -unity-font-style: bold;
}

/* Progress Bar — G-04 */
.progress-container {
    background-color: rgba(0, 0, 0, 0.4);
    height: 20px;
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill {
    background-color: #FFD166;
    height: 100%;
    border-radius: 10px;
}

/* G-09: Progress bar — dùng solid color thay gradient (USS không hỗ trợ linear-gradient) */
.progress-fill.gradient {
    background-color: #197BF0;
}

/* Popup Overlay — G-19 */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Spinner cho matchmaking — G-14 (dùng border-top-color animation trong code) */
.spinner {
    width: 80px;
    height: 80px;
    border-width: 8px;
    border-color: rgba(255, 255, 255, 0.2);
    border-top-color: #FFD166;
    border-radius: 50%;
    margin-bottom: 30px;
}

/* Timer Ring — G-16 */
.timer-ring {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 8px;
    border-color: rgba(255, 255, 255, 0.3);
}

/* XP Bar */
.xp-bar-container {
    background-color: rgba(0, 0, 0, 0.3);
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
    margin-top: 4px;
}
.xp-bar-fill {
    background-color: #8E44AD;
    height: 100%;
    border-radius: 4px;
}
